	partition 'Supplier Summary-1b1bfc72-f8a8-4951-93ea-8f9df9a7662c' = calculated
		mode: import
		source = ```
				SUMMARIZECOLUMNS(
				    'H&M SE0591 ShipmentsDims'[Sender_Code], 
				                                        "CO2 TONNE", SUM('H&M SE0591 ShipmentsFacts'[Calc CO2]), 
				                                        "Transport Spend", SUM('H&M SE0591 ShipmentsFacts'[Revenue]),
				                                        "Purchase Orders",DISTINCTCOUNT('H&M SE0591 Orders'[Purchase Order Number]),
				                                        "CBM",SUM('H&M SE0591 ShipmentsFacts'[Cubic Meters CBM]),
				                                        "Weight Kgs",SUM('H&M SE0591 ShipmentsFacts'[Gross Weight KGs]),
				                                        "Shipments",DISTINCTCOUNT('H&M SE0591 ShipmentsDims'[Shipment]),
				                                        "FrKg",SUM('H&M SE0591 ShipmentsFacts'[Freight Chargeable Weight KGs])                                
				                                    )
				```

	annotation PBI_Id = 62d5b7dedaf0450f9d4779ec0e473258


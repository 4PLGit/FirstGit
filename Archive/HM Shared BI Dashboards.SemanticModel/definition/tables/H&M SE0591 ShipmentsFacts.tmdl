	column 'Shipment Distance' = ```
			
			//uses calculated KM from TMS [Km], is htis is missing a value is supplied form the supporting table "Distances between cities world wide". The distances in the table is calculated between histoircal Loading and Unloading adresses and averaged.
			VAR CNTCNTLane = RELATED('H&M SE0591 ShipmentsDims'[CNTCNTLane])
			
			
			VAR AlternativeDistance = LOOKUPVALUE('Distances between cities world wide'[KM Capitol Cities],'Distances between cities world wide'[CNTCNT],CNTCNTLane)
			
			RETURN 
			    ROUND(AlternativeDistance,0)
			```
		lineageTag: d31cfdb3-5d69-4b88-b3da-cf393be3446e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Calc CO2' =
			
			//CO2 Emissions calulated using average distances of transport (capitol city to capitol city) and the shipment's actual weight.
			VAR ShipmentWeightTonne = DIVIDE([Gross Weight KGs],1000)
			RETURN
			
			ROUNDUP(
			    SWITCH(
			         RELATED('H&M SE0591 ShipmentsDims'[Service Type]),
			         "Sea Freight",ShipmentWeightTonne * [Shipment Distance]*15/1000000 ,
			         "Air Freight",ShipmentWeightTonne * [Shipment Distance]*602/1000000,
			         "Courier",ShipmentWeightTonne * [Shipment Distance]*602/1000000,
			         "Road Transport",ShipmentWeightTonne * [Shipment Distance]*62/1000000,
			         "Train Transport",ShipmentWeightTonne * [Shipment Distance]*22/1000000
			    ),
			
			4)
		formatString: 0.00000
		lineageTag: aaffd3f3-d487-4ab9-a4aa-8be201b901b6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Col Cost per frkg' = DIVIDE([Revenue],[Freight Chargeable Weight KGs])
		lineageTag: 6bbf78f4-bf7a-4c08-8f6d-5d9a385a6710
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CO2/CBM = DIVIDE('H&M SE0591 ShipmentsFacts'[Calc CO2],'H&M SE0591 ShipmentsFacts'[Cubic Meters CBM])
		formatString: 0.00000000
		lineageTag: ebe0cb33-730c-4cef-a3d6-3e8da2d15011

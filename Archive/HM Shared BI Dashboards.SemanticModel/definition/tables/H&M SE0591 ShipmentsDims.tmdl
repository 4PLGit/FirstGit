	column 'Faulty Shipment' =
			SWITCH(TRUE(),'H&M SE0591 ShipmentsDims'[Service Type]="Warehousing","OK",
			'H&M SE0591 ShipmentsDims'[Ref]="Splitpoint", "OK",
			IF(RELATED('H&M SE0591 ShipmentsFacts'[Freight Chargeable Weight KGs])>100000,"Do not include","OK"))
		lineageTag: 25a6eb9c-6f77-4a64-8b36-e791c1696d4d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Franchise Partner' =
			SWITCH(
				TRUE,
				ISBLANK('H&M SE0591 ShipmentsDims'[Unloading Country]),
				"(Blank)",
				'H&M SE0591 ShipmentsDims'[Unloading Country] IN {"AE",
					"BH",
					"EG",
					"JO",
					"KW",
					"LB",
					"OM",
					"QA",
					"SA",
					"TN"},
				"Alshaya",
				'H&M SE0591 ShipmentsDims'[Unloading Country] IN {"ID",
					"KH",
					"TH"},
				"Gill Capital",
				'H&M SE0591 ShipmentsDims'[Unloading Country] IN {"CR",
					"DO",
					"GT",
					"PA",
					"SV",
					"VE"},
				"Hola Moda",
				'H&M SE0591 ShipmentsDims'[Unloading Country] IN {"MA",
					"MT"},
				"Hudson",
				'H&M SE0591 ShipmentsDims'[Unloading Country] IN {"IL"},
				"Match Retail",
				'H&M SE0591 ShipmentsDims'[Unloading Country] IN {"MX"},
				"Retail Fashion Group",
				'H&M SE0591 ShipmentsDims'[Unloading Country] IN {"AZ"},
				"Sinteks",
				"H&M incl brands (Other)"
			)
		lineageTag: 29059e61-7ab3-451e-bdd1-fa1455bf1a71
		summarizeBy: none


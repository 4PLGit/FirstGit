                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "If the planned delivery date is June 15th and the actual delivery happens on June 18th, the deviation is +3 days.",

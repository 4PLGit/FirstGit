                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Business Question",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How accurately do carriers execute deliveries compared to the planned schedule?",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Definition",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This KPI measures the time difference between:",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The planned unloading date, and",

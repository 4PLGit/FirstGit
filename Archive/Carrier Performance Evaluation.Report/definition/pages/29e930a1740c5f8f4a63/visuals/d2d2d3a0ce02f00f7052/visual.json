                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "The actual unloading date (when the delivery was completed)",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The difference is calculated in calendar days.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "If the delivery is completed on the same day as planned, the deviation is 0 days",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Positive values indicate late deliveries",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Negative values indicate deliveries made earlier than planned",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Interpretation",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " This KPI reflects how closely carriers follow the planned delivery schedule.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Values close to 0: high planning accuracy and reliable execution",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Positive values: delays in delivery",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Negative values: early deliveries (which may indicate planning misalignment)",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [

                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "The actual loading date (when the pickup was completed)",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The difference is calculated in calendar days.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "If the pickup is completed on the same day as planned, the deviation is 0 days",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Positive values indicate delays",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Negative values indicate the pickup was done earlier than planned",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Interpretation",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This KPI reflects how closely carriers follow the planned pickup schedule.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Values close to 0: high planning accuracy and good execution",

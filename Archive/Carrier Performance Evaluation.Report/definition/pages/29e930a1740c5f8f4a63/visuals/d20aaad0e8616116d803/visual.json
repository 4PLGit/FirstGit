              },
              {
                "textRuns": [
                  {
                    "value": "Business Question",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How many times does the actual pickup deviate from the initial plan?",

                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "If the first requested planned pickup date is June 17th at 08:00 and the final planned pickup is June 20th at 00:00, the deviation is less than +3 days, which is a not violation.",

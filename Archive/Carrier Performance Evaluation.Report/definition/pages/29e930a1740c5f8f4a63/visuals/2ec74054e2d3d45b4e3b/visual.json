                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "The actual unloading date (when delivery was completed)",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A violation occurs when:",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The delivery occurs more than 3 days earlier than the first requested planned date (< -3 days), OR",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "The delivery occurs after the final planned unloading date by a carrier",

                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "If the initially requested planned delivery date is June 21st and the actual delivery date is June 19th, the difference is -2 days. This is less than -3 days, which is not a deviation.",

                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How much does the actual delivery deviate from the initial plan by 4PLCS?",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"

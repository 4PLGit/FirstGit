                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Interpretation",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This KPI reflects execution performance against the original delivery plan.",

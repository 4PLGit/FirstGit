                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Early or late deliveries outside the allowed window indicate poor adherence to the agreed schedule.",

                  {
                    "value": "Planned Pickup (Latency & SLA Violation)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [

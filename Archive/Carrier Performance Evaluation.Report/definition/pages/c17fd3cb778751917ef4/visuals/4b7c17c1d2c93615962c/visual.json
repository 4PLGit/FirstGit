                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Confirmation",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Confirmation of transport orders in TMS-extranet is expected to happen within two hours of the transportation order being sent from 4PLCS to the carrier during regular office hours. Confirmations happening later than two office hours are logged as a violation.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pickup and delivery SLAs",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Standard transport order comes with a planned pickup date and time from the 4PLCS dispatcher. Carriers are allowed to plan and execute pickup within a time span of three days starting from the day of requested pickup. If a carrier plan or executes pickup later than three days from the requested date a violation is logged on the transport order.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Deliveries are allowed to be planned and executed three days earlier than the requested delivery time, but not later than the requested time. Deviations to this agreement is logged as a violation on the transport order.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [

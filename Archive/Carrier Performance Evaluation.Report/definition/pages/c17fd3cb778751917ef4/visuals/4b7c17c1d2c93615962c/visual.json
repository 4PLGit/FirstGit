                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Reported pickup and delivery",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The actual time of pickup and delivery is expected to be reported back in TMS-extranet within 24 hours of each event. Event times being reported more than 24 hours after occurrence are logged as deviations on the transport order.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Leadtime",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Arial",
                      "fontSize": "12pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The transport lead time is calculated from the actual loading and delivery events as reported by the carrier. The reported transit times are regularly checked against transit times stated by the carrier in the annual tender.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt",

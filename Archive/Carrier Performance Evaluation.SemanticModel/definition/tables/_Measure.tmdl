		lineageTag: 9dec39e6-9e06-4c37-8e0d-bfdde7b1e5ac

	measure 'Debug Selected Period' =
			
			FORMAT([Debug Selected Start], "yyyy-MM-dd")
			    & " / "
			    & FORMAT([Debug Selected End], "yyyy-MM-dd")
		lineageTag: 5e842dc4-0b2d-499b-b0f3-3b4beb1219e4

	measure 'Debug -1M Period' =
			
			VAR _End = [Debug Selected End]
			VAR _PrevEnd = EOMONTH(_End, -1)
			VAR _PrevStart = EOMONTH(_End, -2) + 1
			RETURN
			FORMAT(_PrevStart, "yyyy-MM-dd")
			    & " / "
			    & FORMAT(_PrevEnd, "yyyy-MM-dd")
		lineageTag: f8317e48-0749-4be7-b1a5-defd0d5d4c87


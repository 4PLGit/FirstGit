table _Measure
	lineageTag: baca69f4-db02-4020-961e-c86fa53992e8

	measure Total_Violations =
			
			SUM('Jobs_Events_Dates'[Planning_SLA_Violation])
		formatString: 0
		lineageTag: 40af4346-54dd-41d6-8299-5b4535c81912

	measure Violation_% =
			
			DIVIDE(
			    [Total_Violations],
			    [Total_Jobs]
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 4c13f565-b163-41a2-8aee-9534187eaa8b

	measure 'Avg_Confirmation_Latency (min)' =
			
			AVERAGE(Jobs_Events_Dates[Confirmation_Latency (min)])
		lineageTag: 442cdfd6-9665-4ada-a136-318e6c956a1a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Confirmation_Violation_Total =
			
			SUM(Jobs_Events_Dates[Confirmation_Violation])
		formatString: 0
		lineageTag: 56a7b00e-bb8f-4ccf-8af1-2abfa5fff85f

	measure Confirmation_Violation_% =
			
			DIVIDE([Confirmation_Violation_Total], [Confirmed_Total_Jobs])
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: bbcd9235-20a2-4d31-83bf-cc066f3390d4

	measure Total_Jobs = COUNTROWS(Jobs_Events_Dates)
		formatString: 0
		lineageTag: 947ac4bb-cd95-4cae-b5a1-755bcc3ac9e7

	measure Confirmed_Total_Jobs = ```
			
			COUNTROWS(
			    FILTER('Jobs_Events_Dates', 
			           NOT(ISBLANK('Jobs_Events_Dates'[Confirmation_Violation])))
			)
			```
		formatString: 0
		lineageTag: ab0d5511-af40-4fe0-87a1-1edeb768a4aa


	measure Confirmation_Selection =
			
			IF(
			    "Confirmation" IN VALUES(KPI_Main[KPI]),
			    [Confirmation_Violation_%],
			    BLANK()
			)
		lineageTag: d2b275f7-f8dd-4079-8c72-d1e00b7e27dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Overall_Performance_% =
			
			VAR Confirmation = 1- [Confirmation_Violation_%]
			VAR Loading_Planned  = 1- [Loading_Plan_Violation_%]
			VAR Loading_Actual = 1- [Loading_Actual_Violation_%]
			VAR Loading_Reported = 1 - [Loading_Reporting_Violation_%]
			VAR Unloading_Planned = 1 - [Unloading_Plan_Violation_%]
			VAR Unloading_Actual = 1 - [Unloading_Actual_Violation_%]
			VAR Unloading_Reported = 1 - [Unloading_Reporting_Violation_%]
			
			RETURN
			(
			    Confirmation * 0.143 +
			    Loading_Planned * 0.143 +
			    Loading_Actual * 0.143 +
			    Loading_Reported * 0.143 +
			    Unloading_Planned * 0.143 +
			    Unloading_Actual * 0.143 +
			    Unloading_Reported * 0.143
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: f6c376b4-7a54-42b1-aa8b-32267daddcf6

	measure Confirmation_Violation_%_Minus1M =
			
			VAR _End = [Debug Selected End]
			VAR _PrevEnd = EOMONTH(_End, -1)
			VAR _PrevStart = EOMONTH(_End, -2) + 1
			RETURN
			CALCULATE(
			    [Confirmation_Violation_%],
			    REMOVEFILTERS('DimDate'),
			    DATESBETWEEN(
			        'DimDate'[Date],
			        _PrevStart,
			        _PrevEnd
			    )
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 3e5aafb7-26bb-4248-bbdc-018953dcf4aa


	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2030, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month No", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMMM" ),
				    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Weekday No", WEEKDAY ( [Date], 2 ),
				    "Weekday", FORMAT ( [Date], "dddd" )
				)

	annotation PBI_Id = 36dad3bde3ef4303901c53037aa13deb


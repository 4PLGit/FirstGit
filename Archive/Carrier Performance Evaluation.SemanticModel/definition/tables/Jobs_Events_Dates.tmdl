	column Relational_MJB350
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 364e9346-7054-4adf-a371-32a4b5312768
		summarizeBy: none
		sourceColumn: Relational_MJB350

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition Jobs_Events_Dates = m
		mode: import
		source = ```
				let
				    Source = Table.NestedJoin(Event_Date, {"Job Number"}, Scheduled_Date, {"Job Number"}, "Scheduled_Date", JoinKind.LeftOuter),
				    #"Expanded Scheduled_Date" = Table.ExpandTableColumn(Source, "Scheduled_Date", {"MJB260_Scheduled", "MJB290_Scheduled", "MJB350_Scheduled", "MJB600_Scheduled"}, {"MJB260_Scheduled", "MJB290_Scheduled", "MJB350_Scheduled", "MJB600_Scheduled"}),
				    #"Merged Queries" = Table.NestedJoin(#"Expanded Scheduled_Date", {"Job Number"}, Completed_Date, {"Job Number"}, "Completed_Date", JoinKind.LeftOuter),
				    #"Expanded Completed_Date" = Table.ExpandTableColumn(#"Merged Queries", "Completed_Date", {"MJB260_Completed", "MJB290_Completed", "MJB350_Completed", "MJB600_Completed"}, {"MJB260_Completed", "MJB290_Completed", "MJB350_Completed", "MJB600_Completed"}),
				    Confirmation = Table.AddColumn(#"Expanded Completed_Date", "Confirmation_Working_Minutes", each if [MJB260_Completed] = null or [MJB290_Completed] = null then 
				    null 
				else 
				    Working_Minutes([MJB260_Completed], [MJB290_Completed])),
				    #"Changed Type1" = Table.TransformColumnTypes(Confirmation,{{"Confirmation_Working_Minutes", Int64.Type}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type1", "Status_Prio", each if [Current Status] = "600" then 6 else if [Current Status] = "550" then 5 else if [Current Status] = "500" then 4 else if [Current Status] = "450" then 3 else if [Current Status] = "290" then 2 else if [Current Status] = "260" then 1 else 0),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Added Conditional Column",{{"Status_Prio", type text}}),
				    #"Grouped Rows" = Table.Group(#"Changed Type2", {"Job Number"}, {{"AllRows", each _, type table [Job Number=nullable text, Current Status=nullable text, Carrier Name=nullable text, MJB260_Event=nullable datetime, MJB290_Event=nullable datetime, MJB350_Event=nullable datetime, MJB600_Event=nullable datetime, MJB260_Scheduled=nullable datetime, MJB290_Scheduled=nullable datetime, MJB350_Scheduled=nullable datetime, MJB600_Scheduled=nullable datetime, MJB260_Completed=nullable datetime, MJB290_Completed=nullable datetime, MJB350_Completed=nullable datetime, MJB600_Completed=nullable datetime, Confirmation_Working_Minutes=nullable number, Status_Prio=number]}}),
				    #"Added Custom" = Table.AddColumn(#"Grouped Rows", "Sorted", each Table.Sort([AllRows], {{"Status_Prio", Order.Descending}})),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Filled", each let
				    down = Table.FillDown([Sorted], {
				        "MJB260_Event",
				        "MJB290_Event",
				        "MJB350_Event",
				        "MJB600_Event",
				        "MJB260_Scheduled",
				        "MJB290_Scheduled",
				        "MJB350_Scheduled",
				        "MJB600_Scheduled",
				        "MJB260_Completed",
				        "MJB290_Completed",
				        "MJB350_Completed",
				        "MJB600_Completed"
				    }),
				
				    up = Table.FillUp(down, {
				        "MJB260_Event",
				        "MJB290_Event",
				        "MJB350_Event",

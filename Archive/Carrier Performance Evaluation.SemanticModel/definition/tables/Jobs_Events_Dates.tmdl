	column Confirmation_Working_Minutes
		dataType: int64
		formatString: 0
		lineageTag: 8b77b73a-879d-485e-8b0f-53a7d9f8430f
		summarizeBy: sum
		sourceColumn: Confirmation_Working_Minutes

		annotation SummarizationSetBy = Automatic

	column Confirmation_Violation =
			
			IF(ISBLANK([Confirmation_Working_Minutes]),
			    BLANK(),
			    IF([Confirmation_Working_Minutes] > 120,
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: c88d98aa-50c9-4058-bd83-87eec009114d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Loading_Plan_Violation = ```
			
			VAR HasChange =
			    NOT(ISBLANK(RELATED(Loading_Changes[Initial_Loading_Change_From])))
			
			RETURN
			IF(
			    HasChange,
			    
			    -- Case 1: CHGLOD exists
			    IF(
			        RELATED(Loading_Changes[Initial_Loading_Change_From]) + 3 <
			        'Jobs_Events_Dates'[MJB350_Scheduled],
			        1,
			        0
			    )
			
			)
			```
		formatString: 0
		lineageTag: f1a84985-7a3f-435b-a1d9-de9e2952c58b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Loading_Actual_Violation = ```
			
			VAR HasChange =
			    NOT(ISBLANK(RELATED(Loading_Changes[Initial_Loading_Change_From])))
			
			RETURN
			IF(
			    HasChange,
			    
			    -- Case 1: CHGLOD exists
			    IF(
			        RELATED(Loading_Changes[Initial_Loading_Change_From]) + 3 <
			        'Jobs_Events_Dates'[MJB350_Completed],
			        1,
			        0
			    ),
			
			    -- Case 2: No CHGLOD
			  IF( 'Jobs_Events_Dates'[MJB350_Scheduled] + 3 < 'Jobs_Events_Dates'[MJB350_Completed], 1, 0 ) )
			```
		lineageTag: 99708cec-4e82-460b-af78-62b94391ee13
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Loading_Reporting_Violation =
			
			IF(ISBLANK([Loading_Reporting_Minutes_NoWeekend]),
			    BLANK(),
			    IF([Loading_Reporting_Minutes_NoWeekend] > 1440,
			        1,
			        0
			    )
			)
		lineageTag: 713b4df8-5f18-4100-8a8a-c991f52ccc9e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Loading_Reporting_Minutes_NoWeekend = ```
			
			VAR StartDate = 'Jobs_Events_Dates'[MJB350_Completed]
			VAR EndDate   = 'Jobs_Events_Dates'[MJB350_Event]
			
			RETURN
			IF(
			    ISBLANK(StartDate) || ISBLANK(EndDate),
			    BLANK(),
			    
			    SUMX(
			        ADDCOLUMNS(
			            CALENDAR(StartDate, EndDate),
			            "IsWeekend", WEEKDAY([Date],2) > 5
			        ),
			        IF(
			            [IsWeekend],
			            0,
			            VAR CurrentDay = [Date]
			            VAR FromTime =
			                IF(CurrentDay = DATEVALUE(StartDate), StartDate, CurrentDay)
			            VAR ToTime =
			                IF(CurrentDay = DATEVALUE(EndDate), EndDate, CurrentDay + 1)
			            RETURN DATEDIFF(FromTime, ToTime, MINUTE)
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: f3cbed2c-4f81-4dc4-bf48-436ecdb3a9fd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Delivery_Plan_Violation = ```
			
			VAR HasChange =
			    NOT(ISBLANK(RELATED('Unloading_Changes'[Initial_Unloading_Change_From])))
			
			VAR Completed = 'Jobs_Events_Dates'[MJB600_Scheduled]
			
			RETURN
			IF(
			    ISBLANK(Completed),
			    BLANK(),
			
			    IF(
			        HasChange,
			        
			        -- Case 1: CHGUND exists
			        IF(
			            Completed < RELATED('Unloading_Changes'[Initial_Unloading_Change_From]) - 3
			            || Completed > RELATED('Unloading_Changes'[Initial_Unloading_Change_From]),
			            1,
			            0
			        ),
			        
			        -- Case 2: No CHGUND 
			        BLANK()   
			    )
			)
			```
		formatString: 0
		lineageTag: 92b8a715-17bc-4cb5-9ceb-360c0fa7cfcf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Delivery_Actual_Violation = ```
			
			VAR HasChange =
			    NOT(ISBLANK(RELATED('Unloading_Changes'[Initial_Unloading_Change_From])))
			
			VAR Completed = 'Jobs_Events_Dates'[MJB600_Completed]
			
			RETURN
			IF(
			    ISBLANK(Completed),
			    BLANK(),
			
			    IF(
			        HasChange,
			        
			        -- Case 1: CHGUND exists
			        IF(
			            Completed < RELATED('Unloading_Changes'[Initial_Unloading_Change_From]) - 3
			            || Completed > RELATED('Unloading_Changes'[Initial_Unloading_Change_From]),
			            1,
			            0
			        ),
			        
			        -- Case 2: No CHGUND 
			        
			        IF(
			            Completed < Jobs_Events_Dates[MJB600_Scheduled] - 3
			            || Completed > Jobs_Events_Dates[MJB600_Scheduled],
			            1,
			            0
			        )
			))
			```
		formatString: 0
		lineageTag: 40973ccc-a8f9-4966-a840-f753b1c0453b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Unloading_Reporting_Violation =
			

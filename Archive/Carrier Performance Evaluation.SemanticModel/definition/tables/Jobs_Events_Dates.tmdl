			    BLANK(),
			    IF([Unloading_Reporting_Minutes_NoWeekend] > 1440,
			        1,
			        0
			    )
			)
		lineageTag: 8b688e2f-b25c-4165-a738-1aec28e7c3c3
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Unloading_Reporting_Minutes_NoWeekend = ```
			
			VAR StartDate = 'Jobs_Events_Dates'[MJB600_Completed]
			VAR EndDate   = 'Jobs_Events_Dates'[MJB600_Event]
			
			RETURN
			IF(

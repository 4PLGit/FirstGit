			            "IsWeekend", WEEKDAY([Date],2) > 5
			        ),
			        IF(
			            [IsWeekend],
			            0,
			            VAR CurrentDay = [Date]
			            VAR FromTime =
			                IF(CurrentDay = DATEVALUE(StartDate), StartDate, CurrentDay)
			            VAR ToTime =
			                IF(CurrentDay = DATEVALUE(EndDate), EndDate, CurrentDay + 1)
			            RETURN DATEDIFF(FromTime, ToTime, MINUTE)
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 538bfc32-ca04-4d55-924d-8c4f59b61387
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Planning_SLA_Violation =
			
			IF(
			    [Loading_Plan_Violation] = 1 || [Delivery_Plan_Violation] = 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 5968a8dc-8d49-4e64-a72f-dd1f070582a5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Unloading_Time_Variance_day =
			
			DIVIDE([Unloading_Variance_Same_Day_zero (min)], 1440)
		lineageTag: ebeccde7-26d0-42cb-9fb1-df73f38a3666
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Unloading_Variance_Same_Day_zero (min)' =
			
			VAR Planned = 'Jobs_Events_Dates'[MJB600_Scheduled]
			VAR Actual  = 'Jobs_Events_Dates'[MJB600_Completed]
			
			RETURN
			IF(
			    ISBLANK(Planned) || ISBLANK(Actual),
			    BLANK(),
			
			    IF(
			        DATEVALUE(Planned) = DATEVALUE(Actual),
			        0,
			        DATEDIFF(Planned, Actual, MINUTE)
			    )
			)
		formatString: 0
		lineageTag: 03f158ab-bd5e-49f6-8fec-c4dba62aa67e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Confirmation_Latency_day =
			
			DIVIDE([Confirmation_Working_Minutes], 540)
		lineageTag: b7828d9a-026b-4377-b2e7-02d6266094ff
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Confirmation_Latency (min)' =
			
			DATEDIFF(
			    [MJB260_Completed],
			    [MJB290_Completed],
			    MINUTE
			)
		formatString: 0
		lineageTag: 92f05dfb-8a26-48db-99e0-dd6853cee985
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column LeadTime_Calendar_Days =
			
			VAR Loading = 'Jobs_Events_Dates'[MJB350_Completed]
			VAR Unloading = 'Jobs_Events_Dates'[MJB600_Completed]
			RETURN
			IF(
			    OR(ISBLANK(Loading), ISBLANK(Unloading)),
			    BLANK(),
			    DATEDIFF(Loading, Unloading, DAY)
			)
		formatString: 0
		lineageTag: 6774cd71-bc44-457a-a310-846635ed09a3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic


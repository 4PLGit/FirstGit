		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Loading_Reporting_Days_NoWeekend =
			
			VAR StartDate = DATEVALUE('Jobs_Events_Dates'[MJB350_Completed])
			VAR EndDate   = DATEVALUE('Jobs_Events_Dates'[MJB350_Event])
			
			RETURN
			IF(
			    ISBLANK(StartDate) || ISBLANK(EndDate),
			    BLANK(),
			
			    COUNTROWS(
			        FILTER(
			            CALENDAR(StartDate, EndDate),
			            WEEKDAY([Date],2) <= 5
			        )
			    ) - 1
			)
		formatString: 0
		lineageTag: 27882e4e-b4dc-48d3-a20a-00a9b670ca8b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic


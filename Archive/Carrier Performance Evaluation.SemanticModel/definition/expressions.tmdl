expression Working_Minutes =
		(Start as datetime, End as datetime) as number =>
		let
		    EndTime = if End = null then DateTime.LocalNow() else End,
		
		    WorkStart = #time(8,0,0),
		    WorkEnd = #time(17,0,0),
		
		    StartDate = Date.From(Start),
		    EndDate = Date.From(EndTime),
		
		    IsWorkday = (d as date) => Date.DayOfWeek(d, Day.Monday) < 5,
		
		    GetMinutesInDay = (d as date) =>
		        let
		            DayStart = DateTime.From(d & WorkStart),
		            DayEnd = DateTime.From(d & WorkEnd),
		
		            ActualStart = if d = StartDate then List.Max({Start, DayStart}) else DayStart,
		            ActualEnd = if d = EndDate then List.Min({EndTime, DayEnd}) else DayEnd,
		
		            Minutes = if ActualEnd > ActualStart then Duration.TotalMinutes(ActualEnd - ActualStart) else 0
		        in
		            if IsWorkday(d) then Minutes else 0,
		
		    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1,0,0,0)),
		
		    Result = List.Sum(List.Transform(Dates, each GetMinutesInDay(_)))
		in
		    Result
	lineageTag: f09acd9b-f75d-4b33-a8d2-ff1c89e9b70b

